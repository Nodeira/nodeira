{
  "name": "nodeira",
  "version": "1.20.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "db:wipe": "node scripts/wipe-db.mjs",
    "mobile:run": "node scripts/mobile-run.mjs",
    "db:up": "docker compose -p nodeira -f docker-compose.dev.yml up -d",
    "test:e2e": "turbo run e2e --filter=@nodeira/e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "prettier": "^3.5.0",
    "semantic-release": "^25.0.3",
    "turbo": "^2.9.6",
    "typescript": "^5.8.0"
  }
}
