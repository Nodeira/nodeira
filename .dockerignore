# Reinstalled fresh during build.
#
# The pattern must be `**/node_modules`, not `node_modules`: .dockerignore patterns are
# anchored to the context root, so the bare form excluded only ./node_modules. The nested
# ones were copied in by `COPY apps/api ./apps/api`, overwriting the workspace symlinks
# pnpm had just created with the host's — which on Windows are absolute
# (`G:/Programming/nodeira/packages/shared-types`) and resolve to nothing in the image.
# @nodeira/shared-types then failed to resolve and the api and web builds died.
**/node_modules

# Version control
.git

# CI config — not needed inside the image
.github

# Turbo cache
.turbo

# Built output (rebuilt from source during Docker build)
apps/api/dist
apps/web/dist
apps/docs/build
apps/docs/.docusaurus

# Environment files (mounted at runtime, never baked in)
.env
.env.*
!apps/api/.env.example

# Logs and test artefacts
*.log
coverage

# Large dev-only reference files
design_notes
llms.txt
no-useeffect.md
CLAUDE.md

# Claude Code local settings
.claude
