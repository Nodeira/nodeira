generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NoteType {
  note
  quick
}

enum Role {
  USER
  ADMIN
}

/// Access level within a single vault. Distinct from Role, which is instance-wide.
enum VaultRole {
  OWNER
  EDITOR
  VIEWER
}

enum ReminderTargetType {
  NONE
  NOTE
  CANVAS
  CANVAS_NODE
}

enum ReminderTriggerType {
  TIME
  LOCATION
}

enum ReminderStatus {
  SCHEDULED
  FIRED
  DISMISSED
  SNOOZED
  CANCELLED
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  name        String?
  role        Role       @default(USER)
  preferences Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  apiTokens    ApiToken[]
  reminders    Reminder[]
  devices      Device[]
  ownedVaults  Vault[]
  memberships  VaultMember[]
  appState     AppState?

  @@map("users")
}

model ApiToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultId    String?   @map("vault_id")
  vault      Vault?    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([userId])
  @@map("api_tokens")
}

model Vault {
  id        String        @id @default(uuid())
  name      String
  ownerId   String        @map("owner_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   VaultMember[]
  notes     Note[]
  folders   Folder[]
  canvases  Canvas[]
  apiTokens ApiToken[]

  @@index([ownerId])
  @@map("vaults")
}

/// The single authorization primitive. Everything inside a vault (notes, folders,
/// canvases) is reachable exactly by the users listed here, at the level given.
model VaultMember {
  vaultId   String    @map("vault_id")
  userId    String    @map("user_id")
  role      VaultRole @default(EDITOR)
  createdAt DateTime  @default(now()) @map("created_at")
  vault     Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([vaultId, userId])
  @@index([userId])
  @@map("vault_members")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  vaultId   String   @map("vault_id")
  parentId  String?  @map("parent_id")
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  notes     Note[]
  canvases  Canvas[]

  @@index([vaultId])
  @@map("folders")
}

model Note {
  id        String     @id @default(uuid())
  title     String     @default("Untitled")
  type      NoteType   @default(note)
  vaultId   String     @map("vault_id")
  folderId  String?    @map("folder_id")
  pinned    Boolean    @default(false)
  icon      String?
  position  Int        @default(0)
  kind      String?
  kindMeta  Json?      @map("kind_meta")
  yjsState  Bytes?     @map("yjs_state")
  tags      String[]   @default([])
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  vault     Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  folder    Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  linksOut  NoteLink[] @relation("NoteLinksOut")
  linksIn   NoteLink[] @relation("NoteLinksIn")

  @@index([vaultId])
  @@index([folderId])
  @@map("notes")
}

model NoteLink {
  sourceId String @map("source_id")
  targetId String @map("target_id")
  source   Note   @relation("NoteLinksOut", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Note   @relation("NoteLinksIn", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@map("note_links")
}

/// One row per user. This used to be a single global row (id = "default"), so every
/// user shared -- and overwrote -- the same set of open tabs.
model AppState {
  userId       String   @id @map("user_id")
  openTabs     String[]
  activeNoteId String?  @map("active_note_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_state")
}

model Canvas {
  id        String   @id @default(uuid())
  title     String   @default("Untitled Canvas")
  vaultId   String   @map("vault_id")
  folderId  String?  @map("folder_id")
  data      Json     @default("{\"nodes\":[],\"edges\":[]}")
  pinned    Boolean  @default(false)
  icon      String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([vaultId])
  @@map("canvases")
}

model Plugin {
  id          String   @id @default(uuid())
  pluginId    String   @unique @map("plugin_id")
  source      String
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("plugins")
}

model Reminder {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String?

  // optional polymorphic target (NONE = standalone reminder)
  targetType     ReminderTargetType @default(NONE) @map("target_type")
  targetNoteId   String?            @map("target_note_id")
  targetCanvasId String?            @map("target_canvas_id")
  targetNodeId   String?            @map("target_node_id") // node id inside a canvas's JSON

  triggerType ReminderTriggerType @map("trigger_type")

  // TIME trigger (server-scheduled)
  fireAt     DateTime? @map("fire_at")
  timezone   String?
  recurrence String? // null = one-shot; DAILY | WEEKLY | MONTHLY | YEARLY

  // LOCATION trigger (evaluated on-device, mobile only)
  lat          Float?
  lng          Float?
  radiusM      Int?     @map("radius_m")
  locationName String?  @map("location_name")
  onLeave      Boolean  @default(false) @map("on_leave") // false = on enter, true = on exit

  status      ReminderStatus @default(SCHEDULED)
  snoozeUntil DateTime?      @map("snooze_until")
  lastFiredAt DateTime?      @map("last_fired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status, fireAt])
  @@map("reminders")
}

model Device {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // ios | android | desktop | web
  pushToken  String?  @map("push_token") // Expo push token (mobile); null for WS-only clients
  name       String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, pushToken])
  @@map("devices")
}
