DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nodeira
PORT=3001
# Optional. Comma-separated allowed origins. Leave unset for a same-origin self-hosted
# install (the API serves the web app), which is also what the CLI expects.
# CORS_ORIGIN=https://notes.example.com
# Required, minimum 32 characters. The server refuses to start without it, and refuses to
# start if it is still this placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
