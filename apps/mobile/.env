# Use apps/mobile as Metro's server root instead of the pnpm workspace root.
# This project's metro.config.js is the "traditional" monorepo setup (manual
# watchFolders + nodeModulesPaths pointing at the workspace). Expo's default
# workspace-root detection disagrees with it, which makes `export:embed` (the
# release JS bundling step in Gradle) resolve the entry point against the wrong
# root and fail with "Unable to resolve module ../../node_modules/expo-router/entry.js".
EXPO_NO_METRO_WORKSPACE_ROOT=1
